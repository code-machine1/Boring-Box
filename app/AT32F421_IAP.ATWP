        <PinSub pinname="PB4" signalname="TMR3_CH1" signaltype="3"/>
        <PinSub pinname="PB5" signalname="TMR3_CH2" signaltype="3"/>
    </PINInfo>
    <ProjectInfomation>
        <ProjectName>AT32F421_IAP</ProjectName>
        <ProjectLocation>D:/Work Area/Code For Myself/Boring Box/app</ProjectLocation>
        <ToolchainIDE>MDK_V5</ToolchainIDE>
        <ARMCompiler>1</ARMCompiler>
        <KeepUserCode>true</KeepUserCode>
        <NotUsedPinAnalog>true</NotUsedPinAnalog>
