#include "ina226_handle.h"
 
#include "perf_counter.h"
ina226_t ina226;

void INA226_WriteReg(uint8_t Register, uint8_t Data_H, uint8_t Data_L)
{
    i2c_start();						  //I2C???
    i2c_send_byte(INA226_W);	       //?????????????§Õ¦Ë?0?????????§Õ??
    i2c_wait_ack(I2C_ACK_TIMEOUT);					//???????
    i2c_send_byte(Register);		//???????????
    i2c_wait_ack(I2C_ACK_TIMEOUT);					//???????
    i2c_send_byte(Data_H);			//?????§Õ?????????????¦Ë
    i2c_wait_ack(I2C_ACK_TIMEOUT);					//???????
    i2c_send_byte(Data_L);			//?????§Õ?????????????¦Ë
    i2c_wait_ack(I2C_ACK_TIMEOUT);					//???????
    i2c_stop();						    //I2C???
}

uint32_t INA226_ReadReg(uint8_t RegAddress)
{
    uint32_t Data;
    i2c_start();						  //I2C???
    i2c_send_byte(INA226_W);	  //?????????
    i2c_wait_ack(I2C_ACK_TIMEOUT);					//???????
    i2c_send_byte(RegAddress);	//???????????
    i2c_wait_ack(I2C_ACK_TIMEOUT);					//???????
    i2c_start();					   	//I2C??????
    i2c_send_byte(INA226_R);	  //?????????
    i2c_wait_ack(I2C_ACK_TIMEOUT);					//???????
    Data = i2c_receive_byte();	//???????????????¦Ë????
    i2c_ack();				  	//???????
    Data = (Data << 8) | i2c_receive_byte();	//???????????????¦Ë????
    i2c_stop();						    //I2C???
    return Data;
}

void INA226_Init(ina226_t *ina226)
{
    INA226_WriteReg(INA226_Configuration, Configuration_H, Configuration_L); //4?????  1.1ms??????  ???????
    INA226_WriteReg(INA226_Calibration, Calibration_H, Calibration_L);       //???? 0x0200
    ina226->BusVoltage = 0;
    ina226->Current = 0;
    ina226->Power = 0;
    ina226->ShuntVoltage = 0;
}

void INA226_Reset(void)
{
    INA226_WriteReg(INA226_Configuration, Configuration_H, Configuration_L); //4?????  1.1ms??????  ???????
    INA226_WriteReg(INA226_Calibration, Calibration_H, Calibration_L);       //???? 0x0200
}

float INA226_GetShuntVoltage(void)//???????? =  ?????? * LSB(2.5uA)
{
    float ShuntVoltage;
    ShuntVoltage = (uint32_t)((INA226_ReadReg(INA226_Shuntvoltage)) * 2.5 / 1000);
    return ShuntVoltage;
}

float INA226_GetBusVoltage(void)//??????? =  ?????? * LSB(1.25mV)
{
    float BusVoltage;
    //BusVoltage = (uint32_t)((INA226_ReadReg(INA226_Busvoltage)) * 1.25);
    BusVoltage = ((INA226_ReadReg(INA226_Busvoltage)) * 0.00125f);
    return BusVoltage;
}

float INA226_GetCurrent(void)//????? = ?????? * Current_LSB(0.05mA)
{
    float Current;
    Current = ((INA226_ReadReg(INA226_Current)) * 0.5);
    return Current;
}

float INA226_GetPower(void)//???? = ?????? * Power_LSB(1.25mW)
{
    float Power;
    Power = ((INA226_ReadReg(INA226_Power)) * 1.25);
    return Power;
}


void ina226_handle(void)
{
    static uint8_t state = 0;
 

    switch (state)
    {
    case 0:
		
 
        ina226.Current = INA226_GetCurrent();
 
	     
        
 
 state++;
	break;
    case 1:
	    	
 ina226.BusVoltage = INA226_GetBusVoltage();
        state = 0;
        break;
    }

 
 
}

